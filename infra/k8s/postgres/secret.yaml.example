# Template — copy to secret.yaml (gitignored) and replace CHANGEME, or create the Secret from the CLI:
#   kubectl create secret generic postgres-credentials -n bernstein-poll \
#     --from-literal=POSTGRES_USER=poll --from-literal=POSTGRES_DB=poll --from-literal=POSTGRES_PASSWORD=...
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: bernstein-poll
type: Opaque
stringData:
  POSTGRES_USER: poll
  POSTGRES_DB: poll
  POSTGRES_PASSWORD: CHANGEME
